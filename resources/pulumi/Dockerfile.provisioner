# MIT ODL provisioner image: uses python:3.13-slim + manually installs Pulumi CLI,
# kubectl, and AWS CLI. Syncs Python dependencies from mitodl/ol-infrastructure via uv.
FROM mitodl/ol-infrastructure AS infra

FROM ghcr.io/astral-sh/uv:latest AS uv

# --- Patched pulumi-terraform-bridge dynamic provider host -----------------
# Works around https://github.com/pulumi/pulumi-terraform-bridge/issues/3514:
# the dynamic Terraform-provider bridge sends a hardcoded, non-semver
# TerraformVersion string during ConfigureProvider. Some wrapped Terraform
# providers parse that field as a semantic version and panic on it, e.g.
# Rootly: https://github.com/rootlyhq/terraform-provider-rootly/issues/379.
# This stage builds a patched bridge binary that instead honors the
# PULUMI_TERRAFORM_VERSION env var (set below), pinned to a specific known-good
# pulumi-terraform-bridge commit for reproducibility (that project does not tag
# releases matching the bridge plugin's own version numbers; those are cut in
# the separate pulumi/pulumi-terraform-provider "release host" repo).
# Remove this whole stage, patches/pulumi-terraform-bridge-terraform-version.patch,
# the COPY below, and the PULUMI_TERRAFORM_VERSION env var once both upstream
# issues are resolved and a released bridge/provider version includes the fix.
FROM golang:1.26.4-bookworm@sha256:b305420a68d0f229d91eb3b3ed9e519fcf2cf5461da4bef997bf927e8c0bfd2b AS terraform-bridge-builder
WORKDIR /src
RUN git init -q && \
    git remote add origin https://github.com/pulumi/pulumi-terraform-bridge && \
    git fetch --depth 1 origin b68f4dbe7ae876b3c304eaf96ba17f341ab9ccc8 && \
    git checkout -q FETCH_HEAD
COPY patches/pulumi-terraform-bridge-terraform-version.patch /tmp/patch.diff
RUN git apply /tmp/patch.diff && \
    go build -o /pulumi-resource-terraform-provider ./dynamic

FROM python:3.14-slim@sha256:b877e50bd90de10af8d82c57a022fc2e0dc731c5320d762a27986facfc3355c1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install --no-install-recommends -y curl git unzip groff mariadb-client && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

# Pre-sync Python dependencies from ol-infrastructure so uv sync is a no-op at runtime
COPY --from=infra /opt/ol-infrastructure/pyproject.toml /opt/ol-infrastructure/
COPY --from=infra /opt/ol-infrastructure/uv.lock /opt/ol-infrastructure/
COPY --from=infra /opt/ol-infrastructure/README.md /opt/ol-infrastructure/
COPY --from=infra /opt/ol-infrastructure/sdks /opt/ol-infrastructure/sdks
RUN uv sync --frozen --project /opt/ol-infrastructure

ENV VIRTUAL_ENV=/opt/ol-infrastructure/.venv
ENV PATH="/opt/ol-infrastructure/.venv/bin:$PATH"

ARG PULUMI_VERSION=latest
RUN curl -fsSL https://get.pulumi.com -o pulumi.sh && \
    /bin/sh pulumi.sh --install-root /usr/local --version "${PULUMI_VERSION}" --silent && \
    rm pulumi.sh

# Install the patched terraform-provider bridge binary built above, at the
# exact plugin cache path Pulumi expects for the "resource-terraform-provider"
# plugin at the pinned bridge version used by sdks/rootly (v1.1.4). Other
# dynamic-provider SDKs pinned to a different bridge version (e.g. qdrant-cloud
# at v1.1.1) are not covered by this and would need their own COPY line if they
# hit the same upstream bug. See the terraform-bridge-builder stage above for
# why this exists and when to remove it.
COPY --from=terraform-bridge-builder /pulumi-resource-terraform-provider \
    /root/.pulumi/plugins/resource-terraform-provider-v1.1.4/pulumi-resource-terraform-provider
RUN chmod +x /root/.pulumi/plugins/resource-terraform-provider-v1.1.4/pulumi-resource-terraform-provider
ENV PULUMI_TERRAFORM_VERSION=1.5.0

# Install kubectl
RUN curl -fsSL "https://storage.googleapis.com/kubernetes-release/release/$(curl -s https://storage.googleapis.com/kubernetes-release/release/stable.txt)/bin/linux/amd64/kubectl" \
    -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl

# Install AWS CLI v2
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o awscliv2.zip && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf awscliv2.zip aws/

WORKDIR /opt/resource/

COPY dist/ dist/
RUN pip install dist/*.whl

COPY concourse.py ./concourse.py
COPY pulumi_utils.py ./pulumi_utils.py
COPY io_utils.py ./io_utils.py
RUN python3 -m concoursetools assets . -r concourse.py

# Automatically install Pulumi plugins for all pulumi packages present in the venv
RUN pip freeze | sort | grep -iE '^pulumi(verse)?[-_]' | \
    sed -E 's/pulumi(verse)?[-_](.*?)==(.*)/resource \2 \3/' | \
    sed 's/_/-/' | \
    while read -r type name version; do \
        pulumi plugin install --non-interactive "$type" "$name" "$version" || \
            echo "WARNING: Skipping plugin install for $name@$version (see error above)" >&2; \
    done

ENTRYPOINT ["python3"]
